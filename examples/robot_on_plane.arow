      joint_position: {translation: [0, 0, 0], rotation: [1, 0, 0, 0]}
      joint_velocity: [0, 0, 0, 0, 0, 0]
      joint_torque: [0, 0, 0, 0, 0, 0]
      visual_extents: [0.12, 0.11, 0.12]
      visual_color: [0.95, 0.55, 0.15]
      collision_pose: {translation: [0, 0.11, 0], rotation: [1, 0, 0, 0]}
      collision_extents: [0.09, 0.08, 0.09]
      collision_radius: [0.03]
      collision_margin: [0.005]
      collision_group: [2]
      collision_mask: [1]
  - name: visor
