+#include "tap/communication/can/can_bus.hpp"
+
+namespace modm::can
+{
+class Message;
+}
+
+namespace tap::arch::hosted
+{
+/**
+ * Peripheral access for the hosted (simulator) build.
+ *
+ * On hardware, CAN, UART and the SPI IMUs are driven through modm's peripheral drivers. In the
+ * hosted build those calls have nothing to talk to; when a backend is installed with
+ * `setHardwareBackend`, they are forwarded to it instead, so an external simulator can stand in
+ * for the robot's hardware at the same interfaces the real peripherals present: raw CAN frames,
+ * UART bytes and IMU data-register bursts. With no backend installed, the hosted build behaves
+ * as it always has (CAN goes to the built-in DJI motor sims, UARTs are silent).
+ */
+class HardwareBackend
+{
+public:
+    /// SPI IMU chips whose data registers a backend can supply.
+    enum class ImuChip : uint8_t
+    {
+        MPU6500 = 0,
+        ISM330 = 1,
+    };
+
+    virtual ~HardwareBackend() = default;
+
+    /// Queues a frame for transmission on the given bus. Returns false if it could not be sent.
+    virtual bool canSend(tap::can::CanBus bus, const modm::can::Message &message) = 0;
+
+    /// Pops the next frame received on the given bus. Returns false if none is waiting.
+    virtual bool canReceive(tap::can::CanBus bus, modm::can::Message *message) = 0;
+
+    /// Reads up to `length` received bytes from a UART port; returns the number read.
+    virtual std::size_t uartRead(uint8_t port, uint8_t *data, std::size_t length) = 0;
+
+    /// Writes bytes out of a UART port; returns the number written.
+    virtual std::size_t uartWrite(uint8_t port, const uint8_t *data, std::size_t length) = 0;
+
+    /// Drops every byte received on a UART port that has not been read yet.
+    virtual std::size_t uartDiscardReceiveBuffer(uint8_t port) = 0;
+
+    /**
+     * Fills `data` with the chip's next data-register burst, in the chip's own register layout
+     * (the bytes the hardware driver would clock out of SPI). `instance` tells apart chips of
+     * the same kind, in construction order. Returns false if no new sample has arrived since
+     * the last call.
+     */
+    virtual bool imuReadBurst(ImuChip chip, uint8_t instance, uint8_t *data, std::size_t length) = 0;
+};
+
+/// Installs (or, with nullptr, removes) the backend. Not owned.
+void setHardwareBackend(HardwareBackend *backend);
+
+/// The installed backend, or nullptr.
+HardwareBackend *getHardwareBackend();
+
+}  // namespace tap::arch::hosted
+
+#endif  // PLATFORM_HOSTED
+
+#endif  // TAPROOT_HOSTED_HARDWARE_BACKEND_HPP_
