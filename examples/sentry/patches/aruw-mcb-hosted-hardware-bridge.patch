+#include "tap/architecture/hosted_hardware_backend.hpp"
+
+#include "modm/architecture/interface/can_message.hpp"
+#include "modm/architecture/interface/clock.hpp"
+
+/*
+ * Wire format. One SOCK_SEQPACKET datagram per message, little endian, no padding. The first
+ * byte is the message type:
+ *
+ *   HELLO  (mcb -> sim)  [0x00][version u8]
+ *   CAN    (both ways)   [0x01][bus u8: 0 = CAN1, 1 = CAN2][length u8][flags u8: bit0 extended,
+ *                         bit1 remote][identifier u32][data 8 bytes]
+ *   UART   (both ways)   [0x02][port u8: tap Uart::UartPort value][length u16][bytes...]
+ *   IMU    (sim -> mcb)  [0x03][chip u8: HardwareBackend::ImuChip][instance u8][length u8]
+ *                        [data-register burst...]
+ *   TIME   (sim -> mcb)  [0x04][simulated time, microseconds u64][step period, microseconds u32]
+ *
+ * The simulator sends TIME once per physics step, before that step's sensor data.
+ */
+
+namespace aruwsrc::communication::sim
+{
+namespace
+{
+constexpr uint8_t PROTOCOL_VERSION = 1;
+
+enum MessageType : uint8_t
+{
+    HELLO = 0x00,
+    CAN = 0x01,
+    UART = 0x02,
+    IMU = 0x03,
+    TIME = 0x04,
+};
+
+constexpr size_t NUM_CAN_BUSES = 2;
+constexpr size_t NUM_UART_PORTS = 8;
+constexpr size_t NUM_IMU_SLOTS = 8;
+constexpr size_t MAX_IMU_BURST = 32;
+// bxCAN has a 3-deep receive FIFO per bus; the hosted main loop drains one frame per bus per
+// pass, far more often than the hardware's interrupt-fed queue would be, so this only matters
+// if the MCB stalls.
+constexpr size_t CAN_RX_QUEUE_DEPTH = 256;
+// The modm UART receive buffers on the MCB.
+constexpr size_t UART_RX_BUFFER_SIZE = 4096;
+
+/// Simulated time, published by the bridge for the clock overrides below.
+std::atomic<bool> simClockActive{false};
+std::atomic<uint64_t> simTimeUs{0};
+std::atomic<uint32_t> simStepUs{0};
+std::atomic<int64_t> simTimeWallUs{0};
+/// What modm's own hosted clocks read when simulated time took over, less the simulated time
+/// then: the clocks carry on from where they were, so timers armed before the simulator
+/// attached (static ones, for instance) still expire on schedule.
+std::atomic<int64_t> milliClockOffsetMs{0};
+std::atomic<int64_t> microClockOffsetUs{0};
+
+/**
+ * Time since this process started: what modm's hosted clocks read before simulated time takes
+ * over. The MCB's clocks start at zero on boot and its 32-bit microsecond clock wraps only after
+ * 71 minutes; counted from the host's uptime instead, they started anywhere and could wrap
+ * mid-run. Steady, so the host's wall clock stepping (as WSL2's does) can't move them either.
+ */
+std::chrono::steady_clock::duration sinceBoot()
+{
+    static const auto boot = std::chrono::steady_clock::now();
+    return std::chrono::steady_clock::now() - boot;
+}
+
+int64_t modmMilliNow()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(sinceBoot()).count();
+}
+
+int64_t modmMicroNow()
+{
+    return std::chrono::duration_cast<std::chrono::microseconds>(sinceBoot()).count();
+}
+
+int64_t wallMicros()
+{
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+/**
+ * The current simulated time: the last stamped step plus however much wall time has passed
+ * since, but never beyond the next step, so time is smooth between steps yet cannot run ahead
+ * of a simulation that has fallen behind real time.
+ */
+uint64_t currentSimMicros()
+{
+    const uint64_t base = simTimeUs.load(std::memory_order_acquire);
+    const int64_t sinceStep = wallMicros() - simTimeWallUs.load(std::memory_order_acquire);
+    const int64_t step = simStepUs.load(std::memory_order_relaxed);
+    const int64_t ahead = sinceStep < 0 ? 0 : (sinceStep >= step ? step - 1 : sinceStep);
+    return base + static_cast<uint64_t>(ahead < 0 ? 0 : ahead);
+}
+
+class SimHardwareBridge final : public tap::arch::hosted::HardwareBackend
+{
+public:
+    explicit SimHardwareBridge(int socketFd) : fd(socketFd)
+    {
+        const char *debugText = std::getenv("ARUW_SIM_DEBUG");
+        debug = debugText != nullptr && debugText[0] != '\0' && debugText[0] != '0';
+    }
+
+    bool canSend(tap::can::CanBus bus, const modm::can::Message &message) override
+    {
+        std::array<uint8_t, 16> packet{};
+        packet[0] = CAN;
+        packet[1] = static_cast<uint8_t>(bus);
+        packet[2] = message.getLength();
+        packet[3] = (message.isExtended() ? 1 : 0) | (message.isRemoteTransmitRequest() ? 2 : 0);
+        const uint32_t id = message.getIdentifier();
+        std::memcpy(&packet[4], &id, sizeof(id));
+        std::memcpy(&packet[8], message.data, 8);
+        return sendPacket(packet.data(), packet.size());
+    }
+
+    bool canReceive(tap::can::CanBus bus, modm::can::Message *message) override
+    {
+        pump();
+        auto &queue = canRx[busIndex(bus)];
+        if (queue.empty())
+        {
+            return false;
+        }
+        *message = queue.front();
+        queue.pop_front();
+        if (debug)
+        {
+            countDelivered(busIndex(bus), message->getIdentifier());
+        }
+        return true;
+    }
+
+    size_t uartRead(uint8_t port, uint8_t *data, size_t length) override
+    {
+        pump();
+        if (port >= NUM_UART_PORTS)
+        {
+            return 0;
+        }
+        auto &buffer = uartRx[port];
+        size_t count = 0;
+        while (count < length && !buffer.empty())
+        {
+            data[count++] = buffer.front();
+            buffer.pop_front();
+        }
+        return count;
+    }
+
+    size_t uartWrite(uint8_t port, const uint8_t *data, size_t length) override
+    {
+        constexpr size_t MAX_CHUNK = 1024;
+        size_t written = 0;
+        while (written < length)
+        {
+            const size_t chunk = std::min(MAX_CHUNK, length - written);
+            std::vector<uint8_t> packet(4 + chunk);
+            packet[0] = UART;
+            packet[1] = port;
+            const uint16_t chunkLength = static_cast<uint16_t>(chunk);
+            std::memcpy(&packet[2], &chunkLength, sizeof(chunkLength));
+            std::memcpy(&packet[4], data + written, chunk);
+            if (!sendPacket(packet.data(), packet.size()))
+            {
+                break;
+            }
+            written += chunk;
+        }
+        return written;
+    }
+
+    size_t uartDiscardReceiveBuffer(uint8_t port) override
+    {
+        pump();
+        if (port >= NUM_UART_PORTS)
+        {
+            return 0;
+        }
+        const size_t dropped = uartRx[port].size();
+        uartRx[port].clear();
+        return dropped;
+    }
+
+    bool imuReadBurst(ImuChip chip, uint8_t instance, uint8_t *data, size_t length) override
+    {
+        pump();
+        ImuSlot *slot = findImuSlot(static_cast<uint8_t>(chip), instance, false);
+        if (slot == nullptr || !slot->fresh || length > slot->length)
+        {
+            return false;
+        }
+        std::memcpy(data, slot->burst.data(), length);
+        slot->fresh = false;
+        return true;
+    }
+
+    bool sendHello()
+    {
+        const uint8_t packet[2] = {HELLO, PROTOCOL_VERSION};
+        return sendPacket(packet, sizeof(packet));
+    }
+
+    /// Reads every datagram waiting on the socket.
+    void pump()
+    {
+        std::array<uint8_t, 65536> packet;
+        while (true)
+        {
+            const ssize_t size = recv(fd, packet.data(), packet.size(), MSG_DONTWAIT);
+            if (size < 0)
+            {
+                if (errno == EAGAIN || errno == EINTR)
+                {
+                    return;
+                }
+                disconnected("recv failed");
+            }
+            if (size == 0)
+            {
+                disconnected("simulator closed the connection");
+            }
+            handlePacket(packet.data(), static_cast<size_t>(size));
+        }
+    }
+
+private:
+    /// With ARUW_SIM_DEBUG set: once a second, how many frames of each id reached the firmware.
+    void countDelivered(size_t bus, uint32_t id)
+    {
+        deliveredCounts[{bus, id}]++;
+        const int64_t now = wallMicros();
+        if (now - lastDebugPrintUs < 1'000'000)
+        {
+            return;
+        }
+        lastDebugPrintUs = now;
+        std::fprintf(stderr, "sim hardware bridge: CAN frames delivered in the last second:");
+        for (const auto &[key, count] : deliveredCounts)
+        {
+            std::fprintf(stderr, " %zu:0x%03x=%u", key.first + 1, key.second, count);
+        }
+        std::fprintf(stderr, " (queued %zu/%zu)\n", canRx[0].size(), canRx[1].size());
+        deliveredCounts.clear();
+    }
+
+    struct ImuSlot
+    {
+        bool used = false;
+        bool fresh = false;
+        uint8_t chip = 0;
+        uint8_t instance = 0;
+        uint8_t length = 0;
+        std::array<uint8_t, MAX_IMU_BURST> burst{};
+    };
+
+    static size_t busIndex(tap::can::CanBus bus)
+    {
+        return bus == tap::can::CanBus::CAN_BUS1 ? 0 : 1;
+    }
+
+    [[noreturn]] static void disconnected(const char *why)
+    {
+        std::fprintf(stderr, "sim hardware bridge: %s; shutting down\n", why);
+        std::exit(0);
+    }
+
+    bool sendPacket(const uint8_t *packet, size_t size)
+    {
+        while (true)
+        {
+            const ssize_t sent = send(fd, packet, size, MSG_DONTWAIT | MSG_NOSIGNAL);
+            if (sent == static_cast<ssize_t>(size))
+            {
+                return true;
+            }
+            if (sent < 0 && errno == EINTR)
+            {
+                continue;
+            }
+            if (sent < 0 && errno == EAGAIN)
+            {
+                // The simulator isn't keeping up; like a saturated bus, the frame is lost.
+                return false;
+            }
+            if (sent < 0 && (errno == EPIPE || errno == ECONNRESET))
+            {
+                disconnected("simulator closed the connection");
+            }
+            return false;
+        }
+    }
+
+    ImuSlot *findImuSlot(uint8_t chip, uint8_t instance, bool create)
+    {
+        for (auto &slot : imuSlots)
+        {
+            if (slot.used && slot.chip == chip && slot.instance == instance)
+            {
+                return &slot;
+            }
+        }
+        if (!create)
+        {
+            return nullptr;
+        }
+        for (auto &slot : imuSlots)
+        {
+            if (!slot.used)
+            {
+                slot.used = true;
+                slot.chip = chip;
+                slot.instance = instance;
+                return &slot;
+            }
+        }
+        return nullptr;
+    }
+
+    void handlePacket(const uint8_t *packet, size_t size)
+    {
+        switch (packet[0])
+        {
+            case CAN:
+            {
+                if (size < 16 || packet[1] >= NUM_CAN_BUSES)
+                {
+                    return;
+                }
+                uint32_t id;
+                std::memcpy(&id, &packet[4], sizeof(id));
+                modm::can::Message message(id, std::min<uint8_t>(packet[2], 8));
+                message.setExtended(packet[3] & 1);
+                message.setRemoteTransmitRequest(packet[3] & 2);
+                std::memcpy(message.data, &packet[8], 8);
+                auto &queue = canRx[packet[1]];
+                if (queue.size() >= CAN_RX_QUEUE_DEPTH)
+                {
+                    queue.pop_front();  // FIFO overrun: the oldest frame is lost
+                }
+                queue.push_back(message);
+                break;
+            }
+            case UART:
+            {
+                if (size < 4 || packet[1] >= NUM_UART_PORTS)
+                {
+                    return;
+                }
+                uint16_t length;
+                std::memcpy(&length, &packet[2], sizeof(length));
+                length = std::min<uint16_t>(length, static_cast<uint16_t>(size - 4));
+                auto &buffer = uartRx[packet[1]];
+                for (uint16_t i = 0; i < length; i++)
+                {
+                    if (buffer.size() >= UART_RX_BUFFER_SIZE)
+                    {
+                        break;  // receive buffer overrun: later bytes are lost
+                    }
+                    buffer.push_back(packet[4 + i]);
+                }
+                break;
+            }
+            case IMU:
+            {
+                if (size < 4 || packet[3] > MAX_IMU_BURST || size < 4u + packet[3])
+                {
+                    return;
+                }
+                ImuSlot *slot = findImuSlot(packet[1], packet[2], true);
+                if (slot == nullptr)
+                {
+                    return;
+                }
+                slot->length = packet[3];
+                std::memcpy(slot->burst.data(), &packet[4], packet[3]);
+                slot->fresh = true;
+                break;
+            }
+            case TIME:
+            {
+                if (size < 13)
+                {
+                    return;
+                }
+                uint64_t time;
+                uint32_t step;
+                std::memcpy(&time, &packet[1], sizeof(time));
+                std::memcpy(&step, &packet[9], sizeof(step));
+                if (!simClockActive.load())
+                {
+                    milliClockOffsetMs.store(modmMilliNow() - static_cast<int64_t>(time / 1000));
+                    microClockOffsetUs.store(modmMicroNow() - static_cast<int64_t>(time));
+                }
+                // Never step the clock backwards, even across a late stamp.
+                if (time >= currentSimMicros() || !simClockActive.load())
+                {
+                    simStepUs.store(step == 0 ? 1 : step, std::memory_order_relaxed);
+                    simTimeWallUs.store(wallMicros(), std::memory_order_release);
+                    simTimeUs.store(time, std::memory_order_release);
+                }
+                simClockActive.store(true, std::memory_order_release);
+                break;
+            }
+            default:
+                break;
+        }
+    }
+
+    int fd;
+    bool debug = false;
+    std::map<std::pair<size_t, uint32_t>, unsigned> deliveredCounts;
+    int64_t lastDebugPrintUs = 0;
+    std::array<std::deque<modm::can::Message>, NUM_CAN_BUSES> canRx;
+    std::array<std::deque<uint8_t>, NUM_UART_PORTS> uartRx;
+    std::array<ImuSlot, NUM_IMU_SLOTS> imuSlots;
+};
+
+int connectWithRetry(const char *path, double timeoutSeconds)
+{
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    if (std::strlen(path) >= sizeof(address.sun_path))
+    {
+        std::fprintf(stderr, "sim hardware bridge: socket path too long: %s\n", path);
+        std::exit(1);
+    }
+    std::strncpy(address.sun_path, path, sizeof(address.sun_path) - 1);
+
+    const auto deadline =
+        std::chrono::steady_clock::now() + std::chrono::duration<double>(timeoutSeconds);
+    while (true)
+    {
+        const int fd = socket(AF_UNIX, SOCK_SEQPACKET, 0);
+        if (fd < 0)
+        {
+            std::perror("sim hardware bridge: socket");
+            std::exit(1);
+        }
+        if (connect(fd, reinterpret_cast<sockaddr *>(&address), sizeof(address)) == 0)
+        {
+            return fd;
+        }
+        close(fd);
+        if (std::chrono::steady_clock::now() > deadline)
+        {
+            std::fprintf(stderr, "sim hardware bridge: could not connect to %s\n", path);
+            std::exit(1);
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+}
+
+}  // namespace
+
+void connectSimHardwareBridgeFromEnvironment()
+{
+    const char *path = std::getenv("ARUW_SIM_HARDWARE_SOCKET");
+    if (path == nullptr || path[0] == '\0')
+    {
+        return;
+    }
+    const char *timeoutText = std::getenv("ARUW_SIM_CONNECT_TIMEOUT_S");
+    const double timeout = timeoutText != nullptr ? std::atof(timeoutText) : 30.0;
+
+    const int fd = connectWithRetry(path, timeout);
+    static SimHardwareBridge bridge(fd);
+    if (!bridge.sendHello())
+    {
+        std::fprintf(stderr, "sim hardware bridge: handshake failed\n");
+        std::exit(1);
+    }
+
+    // Wait for the simulator's first time stamp so the clock starts on simulated time.
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    while (!simClockActive.load() && std::chrono::steady_clock::now() < deadline)
+    {
+        bridge.pump();
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+
+    tap::arch::hosted::setHardwareBackend(&bridge);
+    std::printf("sim hardware bridge: connected to %s\n", path);
+    std::fflush(stdout);
+}
+
+}  // namespace aruwsrc::communication::sim
+
+// Strong definitions of modm's (weak) hosted clocks: while a simulator is attached, the MCB runs
+// on simulated time.
+modm::chrono::milli_clock::time_point modm::chrono::milli_clock::now() noexcept
+{
+    using aruwsrc::communication::sim::currentSimMicros;
+    using aruwsrc::communication::sim::simClockActive;
+    using aruwsrc::communication::sim::milliClockOffsetMs;
+    if (simClockActive.load(std::memory_order_acquire))
+    {
+        return time_point{duration{static_cast<uint32_t>(
+            static_cast<int64_t>(currentSimMicros() / 1000) + milliClockOffsetMs.load())}};
+    }
+    return time_point{duration{
+        static_cast<uint32_t>(aruwsrc::communication::sim::modmMilliNow())}};
+}
+
+modm::chrono::micro_clock::time_point modm::chrono::micro_clock::now() noexcept
+{
+    using aruwsrc::communication::sim::currentSimMicros;
+    using aruwsrc::communication::sim::simClockActive;
+    using aruwsrc::communication::sim::microClockOffsetUs;
+    if (simClockActive.load(std::memory_order_acquire))
+    {
+        return time_point{duration{static_cast<uint32_t>(
+            static_cast<int64_t>(currentSimMicros()) + microClockOffsetUs.load())}};
+    }
+    return time_point{duration{
+        static_cast<uint32_t>(aruwsrc::communication::sim::modmMicroNow())}};
+}
+
+#endif
