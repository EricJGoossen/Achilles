         )
         self._arducams = init_arducam_aruco(self._config, self._log_dir)
@@ -295,7 +332,7 @@ class MainApplication:
         )
 
         logging.info("Loading detector model...")
-        self._detector = IconTargetDetector(self._config.detector.weights_path)
+        self._detector = self._hardware.create_detector(self._config.detector.weights_path)
 
         logging.info("Starting comms thread...")
         self._uart_thread = Thread(
