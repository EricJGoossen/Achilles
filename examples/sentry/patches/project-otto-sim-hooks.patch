             time.sleep(self._config.realsense_reset.reset_usb_reload_drivers_timer)
 
-        if self._config.realsense_reset.reset_hardware:
+        if self._hardware.manage_devices and self._config.realsense_reset.reset_hardware:
             hardware_reset()
             time.sleep(self._config.realsense_reset.reset_hardware_timer)
