+@dataclass
+class HardwareFactories:
+    """
+    How the application opens the robot's cameras, video recorder and plate detector.
+
+    The defaults open the real devices: RealSense cameras, the Jetson's hardware video encoder,
+    the GPU detector, and the USB/driver resets and device listings that precede them. A
+    simulator substitutes its own and skips the device housekeeping; everything downstream is
+    unchanged. The MCB link and the LiDARs need no factory: they are serial devices opened by path
+    from the configuration.
+
+    Args:
+        create_camera: Opens a camera from its serial number (None: any) and stream settings.
+        create_video_dumper: Opens a video recorder writing to a directory.
+        create_detector: Loads the plate detector from its weights file.
+        manage_devices: Whether to reset USB/drivers/hardware as configured and list the
+            connected cameras before opening them.
+    """
+
+    create_camera: Callable[[Optional[str], RealsenseConfig], ImagesetSource[JetsonTimestamp]] = (
+        RealsenseImagesetSource
+    )
+    create_video_dumper: Callable[[str, VideoDumperConfig], VideoDumper[Imageset[JetsonTimestamp]]] = (
+        HWAccelVideoDumper
+    )
+    create_detector: Callable[[str], TargetDetector] = IconTargetDetector
+    manage_devices: bool = True
+
+
 class MainApplication:
     """
     The top-level Project Otto application.
@@ -154,8 +186,10 @@ class MainApplication:
         self,
         config: ApplicationConfig,
         cli_config: CommandlineOptions,
+        hardware: Optional[HardwareFactories] = None,
     ):
         self._config = config
+        self._hardware = hardware if hardware is not None else HardwareFactories()
 
         self._chassis_buffer: TimestampedHistoryBuffer[JetsonTimestamp, ChassisOdometryState] = (
             TimestampedHistoryBuffer.from_config(self._config.odometry_buffer)
@@ -251,33 +285,36 @@ class MainApplication:
         _ = torch.set_grad_enabled(False)
 
         # BEGIN: Reset USB, Reload drivers, Reset hardware
-        if self._config.realsense_reset.reset_usb:
