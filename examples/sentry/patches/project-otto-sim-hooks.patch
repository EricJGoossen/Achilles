@@ -1,5 +1,6 @@
 import glob
 import logging
+import os
 import subprocess
 from abc import ABC, abstractmethod
 from dataclasses import dataclass
@@ -71,11 +72,20 @@ class LiDAR(ABC):
 
         args:
             port_name: the name of the port to find, e.g. "1-1.2:1.0"
+        A port name that is already a device path (e.g. "/dev/serial/by-path/...", or a simulator's
+        pseudo-terminal) is used as is.
+
         returns:
             the name of the connected USB port, e.g. "/dev/ttyUSB0"
         throws:
             ValueError if no connected USB port is found for the given port name
         """
+        if port_name.startswith("/"):
+            if os.path.exists(port_name):
+                return port_name
+            logging.warning(f"LiDAR device {port_name} does not exist")
+            return None
+
         for tty in glob.glob("/dev/ttyUSB*"):
             result = subprocess.run(["udevadm", "info", "-a", "-n", tty], capture_output=True, text=True)
             for line in result.stdout.splitlines():
